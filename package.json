{
  "name": "exlm-page-performance-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Demo: config-driven sitemap Lighthouse pipeline with parallel shards and artifact lifecycle",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "performance:discover": "node src/discover.mjs",
    "performance:audit": "node src/audit.mjs",
    "performance:summarize": "node src/summarize.mjs",
    "performance:run": "node src/run-local.mjs",
    "performance:live": "PERF_CONFIG=config/performance.exlm.example.json node src/run-local.mjs",
    "performance:live:discover": "PERF_CONFIG=config/performance.exlm.example.json node src/discover.mjs",
    "performance:clean": "node src/cleanup-local.mjs"
  }
}
